# Optional. WhyTrace still produces evidence-backed reports without a model.
# Meterless Runtime (OpenAI-compatible, local)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_TOKEN=
METERLESS_MODEL=meterless/auto

# NVIDIA NIM (Nemotron)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Generic OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional Zetaris federated query (local JSONL is used when unset)
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
